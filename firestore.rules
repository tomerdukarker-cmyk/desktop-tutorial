// כללי האבטחה של Firestore - להדביק ב-Firebase Console > Firestore Database > Rules
// להחליף את שתי הכתובות בכתובות ה-Gmail המורשות (באותיות קטנות) לפני הפרסום.
// בקובץ הזה, שנמצא ב-GitHub הציבורי, נשארות כתובות לדוגמה בלבד.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // רק שני החשבונות האלה יכולים לגשת ללוח
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'first.user@gmail.com',
          'second.user@gmail.com'
        ];
    }

    // משימה חייבת להיות במבנה שהאתר יוצר - שום שדה אחר לא נכנס
    function isValidTask(data) {
      return data.keys().hasOnly(['text', 'done', 'priority', 'category', 'dueDate', 'endDate', 'dueTime', 'createdAt', 'updatedAt'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 200
        && data.done is bool
        && data.priority in ['high', 'medium', 'low']
        && data.category in ['work', 'personal', 'home', 'study', 'health', 'other']
        && data.dueDate is string && (data.dueDate == '' || data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        // סוף טווח (לא חובה - משימות ישנות בלי השדה עדיין תקינות): ריק, או תאריך אחרי ההתחלה
        && (!('endDate' in data) || (data.endDate is string && (data.endDate == ''
            || (data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.dueDate != '' && data.endDate > data.dueDate))))
        && data.dueTime is string && (data.dueTime == '' || data.dueTime.matches('^[0-9]{2}:[0-9]{2}$'))
        && data.createdAt is number
        && data.updatedAt is number;
    }

    match /boards/shared/tasks/{taskId} {
      allow read, delete: if isMember();
      allow create, update: if isMember() && isValidTask(request.resource.data);
    }

    // כל השאר חסום
  }
}
